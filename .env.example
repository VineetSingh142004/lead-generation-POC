# ---- Lead storage & site content (required for live capture and /admin) ----
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admin access for /admin ----
# Without BOTH of these set, /admin refuses to sign anyone in.
# Generate a secret with:  openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---- Lead notifications (optional; the lead is still saved without them) ----
# Manager requirement: "Send Reply to both Company and Customer"
RESEND_API_KEY=
LEAD_FROM_EMAIL="Epoxy Atelier <quotes@yourdomain.com>"
LEAD_NOTIFY_EMAIL=owner@yourdomain.com
